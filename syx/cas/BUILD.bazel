load("//bazel:rust.bzl", "rust")

rust.library(
    name = "cas",
    srcs = [
        "src/builder.rs",
        "src/lib.rs",
        "src/tests.rs",
    ],
    visibility = ["//visibility:public"],
    deps = [
        "//syx/content_addressing",
        "//syx/logger",
        "@crates//:bytes",
        "@crates//:crossbeam-skiplist",
        "@crates//:dashmap",
        "@crates//:futures",
        "@crates//:object_store",
        "@crates//:slatedb",
        "@crates//:tokio",
    ],
)

rust.test(
    name = "cas_test",
    size = "small",
    crate = ":cas",
    deps = [
        "//syx/testing",
    ],
)

rust.test(
    name = "cas_remote_object_store_test",
    size = "small",
    srcs = ["tests/remote_object_store.rs"],
    data = ["@minio_static//file"],
    # The bundled minio_static binary sometimes reports "Server not
    # initialized yet" on its first request right after startup.
    flaky = True,
    # The minio_static runfile is a static Linux/amd64 binary.
    target_compatible_with = [
        "@platforms//cpu:x86_64",
        "@platforms//os:linux",
    ],
    deps = [
        ":cas",
        "//syx/content_addressing",
        "//syx/testing",
        "@crates//:aws-sdk-s3",
        "@crates//:futures",
        "@crates//:object_store",
        "@crates//:tokio",
    ],
)

rust.test_suite(
    name = "cas_test_suite",
    size = "small",
    srcs = [
        "tests/chunks_large_content.rs",
        "tests/command_digest_is_deterministic.rs",
        "tests/command_digest_is_sensitive.rs",
        "tests/fidelity.rs",
        "tests/function_digest_is_deterministic.rs",
        "tests/function_digest_is_sensitive.rs",
        "tests/function_resolves.rs",
        "tests/is_deterministic.rs",
        "tests/missing.rs",
        "tests/persists.rs",
        "tests/reads_into_a_writer.rs",
        "tests/skips_compression_when_not_worthwhile.rs",
        "tests/tree_digest_is_deterministic.rs",
        "tests/tree_digest_is_sensitive.rs",
        "tests/tree_entries.rs",
        "tests/tree_interns.rs",
    ],
    data = ["//:.rustfmt.toml"],
    proc_macro_deps = ["//syx/cas_cbor2"],
    shared_srcs = ["tests/common/mod.rs"],
    deps = [
        ":cas",
        "//syx/cas_testing",
        "//syx/content_addressing",
        "//syx/testing",
        "@crates//:cbor2",
        "@crates//:object_store",
        "@crates//:serde",
        "@crates//:tokio",
    ],
)
