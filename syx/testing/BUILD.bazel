load("@aspect_bazel_lib//lib:copy_file.bzl", "copy_file")
load("@rules_rust//rust:defs.bzl", "rust_library")

# The server `s3::Server` spawns. Linking it here
# keeps that path stable across a version bump.
copy_file(
    name = "s3s_fs",
    testonly = True,
    src = "@crates//:s3s-fs__s3s-fs",
    out = "s3s-fs",
    allow_symlink = True,
    is_executable = True,
)

rust_library(
    name = "testing",
    testonly = True,
    srcs = [
        "src/lib.rs",
        "src/s3.rs",
    ],
    data = [":s3s_fs"],
    visibility = ["//visibility:public"],
    deps = [
        "@crates//:rand",
        "@crates//:runfiles",
        "@crates//:tempfile",
    ],
)
