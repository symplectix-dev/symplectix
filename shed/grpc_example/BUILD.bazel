load("@protobuf//bazel:proto_library.bzl", "proto_library")
load("@rules_rust//rust:defs.bzl", "rust_binary", "rust_library", "rust_test")
load("@rules_rust_prost//:defs.bzl", "rust_prost_library")

package(
    default_testonly = True,
    default_visibility = ["//:__subpackages__"],
)

proto_library(
    name = "echo_proto",
    srcs = ["echo.proto"],
)

# The crate is named after the proto_library rather than after this
# target, so the module path is `echo_proto::`, not `echo_proto_rs::`.
rust_prost_library(
    name = "echo_proto_rs",
    proto = ":echo_proto",
)

rust_library(
    name = "echo",
    srcs = ["echo.rs"],
    deps = [
        ":echo_proto_rs",
        "@crates//:anyhow",
        "@crates//:tonic",
    ],
)

rust_binary(
    name = "server",
    srcs = ["server_main.rs"],
    deps = [
        ":echo",
        "@crates//:anyhow",
        "@crates//:tokio",
        "@crates//:tonic",
    ],
)

rust_binary(
    name = "client",
    srcs = ["client_main.rs"],
    deps = [
        ":echo",
        "@crates//:anyhow",
        "@crates//:tokio",
    ],
)

rust_test(
    name = "echo_test",
    size = "small",
    srcs = ["echo_test.rs"],
    deps = [
        ":echo",
        "@crates//:tokio",
        "@crates//:tonic",
    ],
)
