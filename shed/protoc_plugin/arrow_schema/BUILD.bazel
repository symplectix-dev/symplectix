load("@bazel_skylib//rules:select_file.bzl", "select_file")
load("@rules_proto_grpc//:defs.bzl", "proto_plugin")
load("@rules_rust//rust:defs.bzl", "rust_binary", "rust_library", "rust_test")

package(
    default_testonly = True,
    default_visibility = ["//:__subpackages__"],
)

rust_binary(
    name = "gen_arrow_schema",
    srcs = ["main.rs"],
    deps = [
        "//shed/protoc_plugin",
        "@crates//:anyhow",
        "@crates//:heck",
        "@crates//:prost-reflect",
        "@crates//:prost-types",
        "@crates//:thiserror",
    ],
)

proto_plugin(
    name = "arrow_schema",
    outputs = ["{protopath}.arrow_schema.rs"],
    tool = ":gen_arrow_schema",
)

select_file(
    name = "order_schema_src",
    srcs = "//shed/protoc_plugin/testdata:arrow_schema",
    subpath = "order.arrow_schema.rs",
)

rust_library(
    name = "order_schema_rs",
    srcs = [":order_schema_src"],
    crate_name = "order_schema",
    deps = ["@crates//:arrow-schema"],
)

select_file(
    name = "product_schema_src",
    srcs = "//shed/protoc_plugin/testdata:arrow_schema",
    subpath = "product.arrow_schema.rs",
)

rust_library(
    name = "product_schema_rs",
    srcs = [":product_schema_src"],
    crate_name = "product_schema",
    deps = ["@crates//:arrow-schema"],
)

select_file(
    name = "review_schema_src",
    srcs = "//shed/protoc_plugin/testdata:arrow_schema",
    subpath = "review.arrow_schema.rs",
)

rust_library(
    name = "review_schema_rs",
    srcs = [":review_schema_src"],
    crate_name = "review_schema",
    deps = ["@crates//:arrow-schema"],
)

select_file(
    name = "customer_schema_src",
    srcs = "//shed/protoc_plugin/testdata:arrow_schema",
    subpath = "customer.arrow_schema.rs",
)

rust_library(
    name = "customer_schema_rs",
    srcs = [":customer_schema_src"],
    crate_name = "customer_schema",
    deps = ["@crates//:arrow-schema"],
)

rust_test(
    name = "schema_test",
    size = "small",
    srcs = ["schema_test.rs"],
    deps = [
        ":customer_schema_rs",
        ":order_schema_rs",
        ":product_schema_rs",
        ":review_schema_rs",
        "@crates//:arrow-schema",
    ],
)
